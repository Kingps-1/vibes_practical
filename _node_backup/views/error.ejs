<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error <%= locals.status || 500 %> - Complaint & Service Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="bg-glow-orb-1"></div>
  <div class="bg-glow-orb-2"></div>

  <div class="auth-container">
    <div class="auth-card" style="text-align: center;">
      <div style="font-size: 3rem; font-weight: 800; color: #ef4444; margin-bottom: 0.5rem;">
        <%= locals.status || 500 %>
      </div>
      <h2 style="font-size: 1.5rem; color: #fff; margin-bottom: 1rem;">
        <%= (locals.status === 404) ? 'Page Not Found' : ((locals.status === 403) ? 'Access Denied' : 'Something went wrong') %>
      </h2>
      <p style="color: var(--text-muted); margin-bottom: 1.5rem; font-size: 0.95rem;">
        <%= locals.message || 'An unexpected error occurred. Please return to the homepage or try again later.' %>
      </p>
      <a href="/" class="btn btn-primary" style="display: inline-flex; width: auto; padding: 0.75rem 1.5rem;">
        Return to Dashboard
      </a>
    </div>
  </div>
</body>
</html>
