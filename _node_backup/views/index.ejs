<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Complaint & Service Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="bg-glow-orb-1"></div>
  <div class="bg-glow-orb-2"></div>

  <div class="dashboard-card">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; border-bottom: 1px solid var(--surface-border); padding-bottom: 1.5rem;">
      <div>
        <div class="brand-badge">Complaint & Service Desk</div>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: #fff; margin-top: 0.5rem;">System Overview</h1>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
          <% if (currentUser) { %>
            Logged in as <strong style="color: #fff;"><%= currentUser.name %></strong> (<%= currentUser.email %>)
          <% } else { %>
            Welcome! Please sign in or register to get started.
          <% } %>
        </p>
      </div>
      <div>
        <% if (currentUser) { %>
          <span class="user-badge badge-<%= currentUser.role %>"><%= currentUser.role %></span>
        <% } %>
      </div>
    </div>

    <% if (currentUser) { %>
      <div class="stats-grid">
        <div class="stat-box">
          <div class="stat-label">Session ID</div>
          <div class="stat-val" style="font-size: 0.95rem; font-family: monospace; color: #a5b4fc;">#<%= currentUser.id %></div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Assigned Role</div>
          <div class="stat-val" style="text-transform: capitalize;"><%= currentUser.role %></div>
        </div>
        <div class="stat-box">
          <div class="stat-label">System Status</div>
          <div class="stat-val" style="color: #86efac; font-size: 0.95rem;">● Online & Secure</div>
        </div>
      </div>

      <div style="background: rgba(15, 23, 42, 0.4); border: 1px dashed var(--surface-border); border-radius: var(--radius-md); padding: 1.5rem; text-align: center; margin: 1.5rem 0;">
        <h3 style="color: #cbd5e1; font-size: 1.1rem; margin-bottom: 0.5rem;">Authentication Step Complete!</h3>
        <p style="color: var(--text-muted); font-size: 0.875rem;">
          Your user session is active. Upcoming modules will enable complaint submission, ticket tracking, category assignment, and status updates.
        </p>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <a href="/logout" class="btn btn-secondary" style="width: auto; padding: 0.75rem 1.5rem;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sign Out
        </a>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 2rem 0;">
        <h2 style="color: #fff; margin-bottom: 1rem;">Service Request Management System</h2>
        <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto 2rem;">
          Submit issues, track service statuses, and get prompt resolution updates from support staff.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; max-width: 320px; margin: 0 auto;">
          <a href="/login" class="btn btn-primary">Login</a>
          <a href="/register" class="btn btn-secondary">Register</a>
        </div>
      </div>
    <% } %>
  </div>
</body>
</html>
