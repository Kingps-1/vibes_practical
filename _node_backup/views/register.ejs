<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Complaint & Service Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Ambient background glow elements -->
  <div class="bg-glow-orb-1"></div>
  <div class="bg-glow-orb-2"></div>

  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <div class="brand-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          Account Registration
        </div>
        <h1 class="auth-title">Create Account</h1>
        <p class="auth-subtitle">Register to submit complaints and track request updates</p>
      </div>

      <% if (locals.error) { %>
        <div class="alert alert-danger" role="alert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/register" method="POST" autocomplete="on">
        <div class="form-group">
          <label class="form-label" for="register-name">Full Name</label>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </span>
            <input 
              type="text" 
              id="register-name" 
              name="name" 
              class="form-control" 
              placeholder="John Doe" 
              value="<%= (locals.values && values.name) || '' %>" 
              required 
              autofocus
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="register-email">Email Address</label>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
              </svg>
            </span>
            <input 
              type="email" 
              id="register-email" 
              name="email" 
              class="form-control" 
              placeholder="john@example.com" 
              value="<%= (locals.values && values.email) || '' %>" 
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="register-role">Account Role</label>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </span>
            <select id="register-role" name="role" class="form-control">
              <option value="user" <%= (locals.values && values.role === 'user') ? 'selected' : '' %>>User (Standard Citizen / Requester)</option>
              <option value="staff" <%= (locals.values && values.role === 'staff') ? 'selected' : '' %>>Staff (Support / Officer)</option>
              <option value="admin" <%= (locals.values && values.role === 'admin') ? 'selected' : '' %>>Admin (System Administrator)</option>
            </select>
            <span class="select-caret">▼</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="register-password">Password (min. 6 characters)</label>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0110 0v4" />
              </svg>
            </span>
            <input 
              type="password" 
              id="register-password" 
              name="password" 
              class="form-control" 
              placeholder="••••••••" 
              minlength="6" 
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="register-confirm-password">Confirm Password</label>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0110 0v4" />
              </svg>
            </span>
            <input 
              type="password" 
              id="register-confirm-password" 
              name="confirm_password" 
              class="form-control" 
              placeholder="••••••••" 
              minlength="6" 
              required
            >
          </div>
        </div>

        <button type="submit" class="btn btn-primary" id="register-submit-btn">
          Create Account
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </button>
      </form>

      <div class="auth-footer">
        Already have an account? <a href="/login">Sign in</a>
      </div>
    </div>
  </div>
</body>
</html>
